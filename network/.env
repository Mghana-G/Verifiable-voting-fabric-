COMPOSE_PROJECT_NAME=voting
FABRIC_VERSION=2.5.12
CA_VERSION=1.5.15
COUCHDB_IMAGE=couchdb:3.3

# Peer GRPC ports (host == container)
PEER_IEBC_PORT=7051
PEER_JUDICIARY_PORT=7061
PEER_CIVILSOCIETY_PORT=7071
PEER_MEDIA_PORT=7081

# Orderer GRPC ports (host == container)
ORDERER1_PORT=7050
ORDERER2_PORT=8050
ORDERER3_PORT=9050

# Orderer admin (osnadmin) ports
ORDERER1_ADMIN_PORT=9443
ORDERER2_ADMIN_PORT=9444
ORDERER3_ADMIN_PORT=9445

# CA ports
CA_IEBC_PORT=7054
CA_JUDICIARY_PORT=7064
CA_CIVILSOCIETY_PORT=7074
CA_MEDIA_PORT=7084
CA_ORDERER_PORT=7090

# CouchDB ports (all containers use 5984 internally; distinct host ports)
COUCHDB_IEBC_PORT=5984
COUCHDB_JUDICIARY_PORT=5985
COUCHDB_CIVILSOCIETY_PORT=5986
COUCHDB_MEDIA_PORT=5987
